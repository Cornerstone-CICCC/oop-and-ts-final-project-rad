---
import todoListData from "../data/todoListData.js"
const todosJSON = JSON.stringify(todoListData);

import { todoContext, Priority, type Progress } from "../ts/TodoContext";
---

<p>
    <button class="modal-btn add-btn">+</button>
</p>
<div id="todo-list-container">
</div>

<dialog id="addModal" >
  <div class="modal-write">
    <h2>Created On</h2>
    <form id="todoForm">
        <p>
        <label for="title">Title </label>
        <input type="text" id="title" name="title" placeholder="Enter task title" required />
        </p>

        <p>
        <label for="description">Description </label>
        <textarea id="description" name="description" placeholder="Enter task description"></textarea>
        </p>

        <p>Progress</p>
        <div class="radio-group">
            <label>
            <input type="radio" name="progress" value="Todo" checked>
            Todo
            </label>

            <label>
            <input type="radio" name="progress" value="In Progress">
            In Progress
            </label>

            <label>
            <input type="radio" name="progress" value="Completed">
            Completed
            </label>
        </div>
        <p>Priority</p>
        <div class="radio-group">
        <label class="priority-high">
            <input type="radio"  name="priority" value="1" checked>
            High
        </label>

        <label class="priority-mid">
            <input type="radio"  name="priority" value="2">
            Medium
        </label>

        <label class="priority-low">
            <input type="radio"  name="priority" value="3">
            Low
        </label>
        </div>
        
        <p>
        <label for="deadline">Deadline Setting</label>
        <input type="date" class="c" name="deadline" />
        </p>
        <div class="btn-wrapper">
            <button type="submit" class="addlist-add-btn">Add Task</button>
            <button class="addlist-cancle-btn">Cancle</button>
        </div>
    </form>
  </div>
</dialog>


<dialog id="viewModal" data-todos={todosJSON}>
  <div class="modal-content">
    <span class="close-btn">&times;</span>
    <h1 id="modalTitle">Hello! 👋</h1>
    <p id="modalDesc">This is the content of the modal dialog.</p>
    
    <p id="progressWrapper"> 
        Progress:
        <span id="progressBadge" class="progress-btn"></span>
    </p>

    <p id="periorityWrapper">
        Priority:
        <span id="periorityBadge" class="periority-btn"></span>
    </p>
    
    <p id="registe"> Registe</p>
    <p id="deadline">Deadline</p>
    <p class="btn-wrapper">
        <button class="todo-modify-btn">Modify</button>
        <button class="todo-delete-btn">Delete</button>
    </p>
  </div>
</dialog>


<dialog id="modifyModal" >
  <div class="modal-modify">
    <h2>Created On</h2>
    <form id="modifyForm">
        <p>
        <label for="title">Title </label>
        <input type="text" id="title" name="title" placeholder="Enter task title" required />
        </p>

        <p>
        <label for="description">Description </label>
        <textarea id="description" name="description" placeholder="Enter task description"></textarea>
        </p>

        <p>Progress</p>
        <div class="radio-group">
            <label>
            <input type="radio" name="progress" value="Todo" checked>
            Todo
            </label>

            <label>
            <input type="radio" name="progress" value="In Progress">
            In Progress
            </label>

            <label>
            <input type="radio" name="progress" value="Completed">
            Completed
            </label>
        </div>
        <p>Priority</p>
        <div class="radio-group">
        <label class="priority-high">
            <input type="radio"  name="priority" value="1" checked>
            High
        </label>

        <label class="priority-mid">
            <input type="radio"  name="priority" value="2">
            Medium
        </label>

        <label class="priority-low">
            <input type="radio"  name="priority" value="3">
            Low
        </label>
        </div>
        
        <p>
        <label for="deadline">Deadline Setting</label>
        <input type="date" class="c" name="deadline" />
        </p>
        <div class="btn-wrapper">
            <button type="submit" class="addlist-modify-btn">Modify Task</button>
            <button class="addlist-cancle-btn">Cancle</button>
        </div>
    </form>
  </div>
</dialog>

<script>    
    import { todoContext, Priority, type Progress, type Todo } from "../ts/TodoContext";
    
    
    const viewModal = document.getElementById("viewModal");
    const viewModalTyped = viewModal as HTMLDialogElement | null;
    const closeModalBtn = viewModalTyped?.querySelector(".close-btn") as HTMLButtonElement | null;
    const modalTitle = document.getElementById("modalTitle") as HTMLElement | null;
    const modalDesc = document.getElementById("modalDesc") as HTMLElement | null;
    const progressBadge = document.getElementById("progressBadge") as HTMLElement | null;
    const priorityBadge = document.getElementById("periorityBadge") as HTMLElement | null;
    const modalRegiste = document.getElementById("registe") as HTMLElement | null;
    const modalDeadline = document.getElementById("deadline") as HTMLElement | null;
    const listContainer = document.getElementById("todo-list-container");

    const addModal = document.getElementById("addModal") as HTMLDialogElement | null;
    const addBtn = document.querySelector(".add-btn") as HTMLButtonElement | null;
    const todoForm = document.getElementById("todoForm") as HTMLFormElement | null;
    
    const modifyModal = document.getElementById("modifyModal") as HTMLDialogElement | null;
    const modifyForm = document.getElementById("modifyForm") as HTMLFormElement | null;
    const todoModifyBtn = document.querySelector(".todo-modify-btn") as HTMLButtonElement | null;
    const todoDeleteBtn = document.querySelector(".todo-delete-btn") as HTMLButtonElement | null;


    const deleteTodoList = (id: number) => {
        todoContext.deleteTodo(id); 
        viewModalTyped?.close(); 
    };

    const openModifyModal = (todoId: number) => {
        const todo = todoContext.getTodos().find(t => t.id === todoId);
        if (!todo || !modifyModal || !modifyForm) return;

        viewModalTyped?.close();
        
        (modifyForm.querySelector("#title") as HTMLInputElement).value = todo.title;
        (modifyForm.querySelector("#description") as HTMLTextAreaElement).value = todo.description;
        
        (modifyForm.querySelector(`input[name="progress"][value="${todo.progress}"]`) as HTMLInputElement).checked = true;
        (modifyForm.querySelector(`input[name="priority"][value="${String(todo.priority)}"]`) as HTMLInputElement).checked = true;
        
        (modifyForm.querySelector(`input[name="deadline"]`) as HTMLInputElement).value = todo.deadline;

        modifyForm.dataset.modifyId = String(todo.id); 

        modifyModal.showModal();
    };


    const attachViewModalListeners = () => {
        const todoListData = todoContext.getTodos(); 
        
        document.querySelectorAll<HTMLButtonElement>("#todo-list-container .modal-btn").forEach((btn) => {
            btn.addEventListener("click", () => {
                const todoId = btn.dataset.id;
                const todo = todoListData.find((t:any) => String(t.id) === todoId);

                if (!todo) return; 
                
                if (todoModifyBtn) {
                    todoModifyBtn.dataset.modifyId = todoId;
                }
                if (todoDeleteBtn) {
                    todoDeleteBtn.dataset.deleteId = todoId;
                }
                
                if (modalTitle) modalTitle.textContent =todo.title;
                if (modalDesc) modalDesc.textContent = "Description: " + todo.description;
                if (progressBadge) {
                    progressBadge.textContent = todo.progress;
                    progressBadge.className = 'progress-badge';

                    if (todo.progress === "Todo") {
                        progressBadge.classList.add("todo");
                    } else if (todo.progress === "In Progress") {
                        progressBadge.classList.add("inprogress");
                    } else if (todo.progress === "Completed") {
                        progressBadge.classList.add("completed");
                    }
                }

                if (priorityBadge) {
                    priorityBadge.className = 'priority-badge';

                    if (todo.priority === 1) { 
                        priorityBadge.classList.add("high");
                        priorityBadge.textContent = "High";
                    } else if (todo.priority === 2) {
                        priorityBadge.classList.add("medium");
                        priorityBadge.textContent = "Medium";
                    } else if (todo.priority === 3) {
                        priorityBadge.classList.add("low");
                        priorityBadge.textContent = "Low";
                    }
                }

                if (modalRegiste) modalRegiste.textContent = "Registe: " +todo.date;
                if (modalDeadline) modalDeadline.textContent = "Deadline: " +todo.deadline;

                viewModalTyped?.showModal();
            });
        });
    };

    const renderTodoList = (todos: Todo[]) => {
        if (!listContainer) return;

        listContainer.innerHTML = ''; 

        todos.forEach(todo => {
            const button = document.createElement('button');
            button.className = 'modal-btn';
            button.dataset.id = String(todo.id);
            button.textContent = todo.title;
            listContainer.appendChild(button);
        });

        attachViewModalListeners();
    };

    todoContext.subscribe(renderTodoList);
    renderTodoList(todoContext.loadTodos()); 


    todoDeleteBtn?.addEventListener("click", () => {
        const idToDelete = todoDeleteBtn.dataset.deleteId;
        
        const userConfirmed = confirm("Are you sure you want to delete this to-do list?");

        if (userConfirmed && idToDelete) {
            deleteTodoList(Number(idToDelete));
        }
    });
    
    todoModifyBtn?.addEventListener("click", () => {
        const idToModify = todoModifyBtn.dataset.modifyId;
        if (idToModify) {
            openModifyModal(Number(idToModify));
        }
    });

    addBtn?.addEventListener("click", (e) => {
        e.preventDefault();
        todoForm?.reset(); 
        addModal?.showModal(); 
    });

    todoForm?.addEventListener("submit", (e) => {
        e.preventDefault();

        const formData = new FormData(todoForm);

        const today = new Date();
        const yyyy = today.getFullYear();
        const mm = String(today.getMonth() + 1).padStart(2, "0"); 
        const dd = String(today.getDate()).padStart(2, "0");

        const newTodo = {
            id: Date.now(),
            title: formData.get("title") as string,
            description: formData.get("description") as string,
            progress: formData.get("progress") as Progress, 
            priority: Number(formData.get("priority")) as Priority,
            deadline: formData.get("deadline") as string,
            date: `${yyyy}-${mm}-${dd}`
        };
        todoContext.addTodo(newTodo);
        addModal?.close();
        todoForm.reset();
    });

    modifyForm?.addEventListener("submit", (e) => {
        e.preventDefault();
        
        const formData = new FormData(modifyForm);
        const modifyId = modifyForm.dataset.modifyId;

        if (!modifyId) {
            return;
        }

        const updatedData = {
            title: formData.get("title") as string,
            description: formData.get("description") as string,
            progress: formData.get("progress") as Progress, 
            priority: Number(formData.get("priority")) as Priority,
            deadline: formData.get("deadline") as string,
        };
        
        todoContext.updateTodo(Number(modifyId), updatedData);
        modifyModal?.close();
        modifyForm.reset();
    });

    closeModalBtn?.addEventListener("click", () => viewModalTyped?.close());
    
    const addlistCancleBtn = addModal?.querySelector(".addlist-cancle-btn") as HTMLButtonElement | null;
    addlistCancleBtn?.addEventListener("click", () => addModal?.close());
    
    const modifyCancleBtn = modifyModal?.querySelector(".addlist-cancle-btn") as HTMLButtonElement | null;
    modifyCancleBtn?.addEventListener("click", () => modifyModal?.close());

</script>