---
import Column from "./Column.astro";
import { type Task } from "../classes/TaskList";
import { board } from "../ts/cardScript";

const todos: Task[] = board.getColumn("todo");
const inProgress: Task[] = board.getColumn("in-progress");
const completed: Task[] = board.getColumn("done");
---

<div class="container">
  <div class="sub-container">
    <!-- Column -->
    <Column title={"To Do"} tasks={todos} id={"todo"} />
    <Column title={"In Progress"} tasks={inProgress} id={"in-progress"} />
    <Column title={"Completed"} tasks={completed} id={"done"} />
  </div>
</div>

<style>
  .container {
    background-color: #f5f7fa;
    padding-bottom: 5rem;
  }

  .sub-container {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1rem;
  }

  @media screen and (min-width: 768px) {
    .sub-container {
      flex-direction: row;
      max-width: 1800px;
      margin: 0 auto;
    }
  }
</style>
